# Gradle start up script for POSIX
#

# Set default values for variables
APP_BASE_NAME=`basename "$0"`
APP_HOME="`pwd -P`"

# Use standard gradle wrapper or fallback to gradle command
if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
else
    echo "Gradle wrapper: Running gradle command"
    gradle "$@"
fi
