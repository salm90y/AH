#!/bin/bash

# Find gradle command location
GRADLE_BIN=""

if command -v gradle >/dev/null 2>&1; then
    GRADLE_BIN="gradle"
elif [ -n "$GRADLE_HOME" ] && [ -x "$GRADLE_HOME/bin/gradle" ]; then
    GRADLE_BIN="$GRADLE_HOME/bin/gradle"
elif [ -x "/opt/hostedtoolcache/gradle/8.5/x64/bin/gradle" ]; then
    GRADLE_BIN="/opt/hostedtoolcache/gradle/8.5/x64/bin/gradle"
else
    FOUND_PATH=$(which gradle 2>/dev/null || find /opt /usr /root ~/.gradle -name gradle -type f 2>/dev/null | head -n 1)
    if [ -n "$FOUND_PATH" ]; then
        GRADLE_BIN="$FOUND_PATH"
    fi
fi

if [ -n "$GRADLE_BIN" ]; then
    exec "$GRADLE_BIN" "$@"
else
    echo "Gradle wrapper: Running gradle command"
    gradle "$@"
fi

